@model MedCore.Models.Doctor

<h2>Doctor Details</h2>
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.FullName</dd>
    <dt class="col-sm-2">Specialization</dt>
    <dd class="col-sm-10">@Model.Specialization</dd>
    <dt class="col-sm-2">Department</dt>
    <dd class="col-sm-10">@Model.Department?.Name</dd>
    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.PhoneNumber</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Back</a>