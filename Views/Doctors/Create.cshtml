@model MedCore.ViewModels.DoctorViewModel

<h2>Add Doctor</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label>Full Name</label><input asp-for="FullName" class="form-control" /></div>
    <div class="mb-3"><label>Specialization</label><input asp-for="Specialization" class="form-control" /></div>
    <div class="mb-3"><label>Phone</label><input asp-for="PhoneNumber" class="form-control" /></div>
    <div class="mb-3">
        <label>Department</label>
        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-control"></select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>