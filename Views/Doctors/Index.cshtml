@model List<MedCore.Models.Doctor>

<h2>Doctors</h2>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name..." style="max-width: 300px;" />
    <button type="submit" class="btn btn-secondary">Search</button>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary ms-auto">+ Add Doctor</a>
    }
</form>
<table class="table table-striped">
    <thead><tr><th>Name</th><th>Specialization</th><th>Department</th><th>Phone</th><th></th></tr></thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.FullName</td>
                <td>@d.Specialization</td>
                <td>@d.Department?.Name</td>
                <td>@d.PhoneNumber</td>
                <td>
                    <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-info">View</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        }
                </td>
            </tr>
        }
    </tbody>
</table>