@model MedCore.Models.Bill

<h2>Delete Bill</h2>
<p>Delete bill for <strong>@Model.Appointment?.Patient?.FullName</strong> (@Model.Amount.ToString("C", new System.Globalization.CultureInfo("en-US")))?</p>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>