@model List<MedCore.Models.Bill>

<h2>Bills</h2>
<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name..." style="max-width: 300px;" />
    <button type="submit" class="btn btn-secondary">Search</button>
@if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
{
        <a asp-action="Create" class="btn btn-primary ms-auto">+ Generate Bill</a>
}
</form>
<table class="table table-striped">
    <thead><tr><th>Patient</th><th>Amount</th><th>Status</th><th>Generated</th><th></th></tr></thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Appointment?.Patient?.FullName</td>
                <td>@b.Amount.ToString("C", new System.Globalization.CultureInfo("en-US"))</td>
                <td>@b.Status</td>
                <td>@b.GeneratedOn.ToShortDateString()</td>
                <td>
                    @if (b.Status == MedCore.Models.PaymentStatus.Unpaid)
                    {
                        @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                        {
                            <form asp-action="MarkPaid" asp-route-id="@b.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-outline-success">Mark Paid</button>
                            </form>
                        }
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@b.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    int currentPage = (int)ViewData["CurrentPage"]!;
    int totalPages = (int)ViewData["TotalPages"]!;
}
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}