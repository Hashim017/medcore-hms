@model MedCore.ViewModels.PrescriptionViewModel

<h2>Add Prescription</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label>Appointment</label>
        <select asp-for="AppointmentId" asp-items="ViewBag.Appointments" class="form-control"><option value="">-- Select --</option></select>
    </div>
    <div class="mb-3"><label>Medicines</label><textarea asp-for="Medicines" class="form-control"></textarea></div>
    <div class="mb-3"><label>Instructions</label><textarea asp-for="Instructions" class="form-control"></textarea></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>