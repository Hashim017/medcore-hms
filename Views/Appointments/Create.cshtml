@model MedCore.ViewModels.AppointmentViewModel

<h2>Book Appointment</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label>Patient</label>
        <select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-control"><option value="">-- Select --</option></select>
    </div>
    <div class="mb-3">
        <label>Doctor</label>
        <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-control"><option value="">-- Select --</option></select>
    </div>
    <div class="mb-3"><label>Date & Time</label><input asp-for="AppointmentDate" class="form-control" /></div>
    <div class="mb-3"><label>Notes</label><textarea asp-for="Notes" class="form-control"></textarea></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>