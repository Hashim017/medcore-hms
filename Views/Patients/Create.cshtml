@model MedCore.ViewModels.PatientViewModel

<h2>Add Patient</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label>Full Name</label><input asp-for="FullName" class="form-control" /></div>
    <div class="mb-3"><label>Date of Birth</label><input asp-for="DateOfBirth" class="form-control" /></div>
    <div class="mb-3">
        <label>Gender</label>
        <select asp-for="Gender" class="form-control">
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
        </select>
    </div>
    <div class="mb-3"><label>Phone</label><input asp-for="PhoneNumber" class="form-control" /></div>
    <div class="mb-3"><label>Email</label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-3"><label>Address</label><input asp-for="Address" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>