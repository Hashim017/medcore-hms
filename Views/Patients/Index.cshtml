@model List<MedCore.Models.Patient>

<h2>Patients</h2>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name..." style="max-width: 300px;" />
    <button type="submit" class="btn btn-secondary">Search</button>
    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
    {
        <a asp-action="Create" class="btn btn-primary ms-auto">+ Add Patient</a>
    }
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>DOB</th>
            <th>Gender</th>
            <th>Phone</th>
            <th>Registered</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.FullName</td>
                <td>@p.DateOfBirth.ToShortDateString()</td>
                <td>@p.Gender</td>
                <td>@p.PhoneNumber</td>
                <td>@p.RegisteredOn.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info">View</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                    {
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    int currentPage = (int)ViewData["CurrentPage"]!;
    int totalPages = (int)ViewData["TotalPages"]!;
}
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?search=@ViewData["Search"]&page=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}