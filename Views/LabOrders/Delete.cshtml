@model MedCore.Models.LabOrder

<h2>Delete Lab Order</h2>
<p>Are you sure you want to delete this lab test?</p>

<div class="mc-card">
    <p><strong>Patient:</strong> @Model.Patient?.FullName</p>
    <p><strong>Doctor:</strong> @Model.Doctor?.FullName</p>
    <p><strong>Test:</strong> @Model.TestName (@Model.TestCode)</p>
    <p><strong>Status:</strong> @Model.Status</p>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>