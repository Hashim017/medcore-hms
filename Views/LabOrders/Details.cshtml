@model MedCore.Models.LabOrder

<h2>Lab Order Details</h2>
<dl class="row">
    <dt class="col-sm-2">Patient</dt>
    <dd class="col-sm-10">@Model.Patient?.FullName</dd>
    <dt class="col-sm-2">Doctor</dt>
    <dd class="col-sm-10">@Model.Doctor?.FullName</dd>
    <dt class="col-sm-2">Test</dt>
    <dd class="col-sm-10">@Model.TestName (@Model.TestCode)</dd>
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>
    @if (Model.ResultValue != null)
    {
        <dt class="col-sm-2">Result</dt>
        <dd class="col-sm-10">@Model.ResultValue</dd>
    }
</dl>

<h5>Outbound HL7 (Order Message)</h5>
<pre class="bg-light p-3 border">@Model.Hl7OrderMessage</pre>

@if (Model.Hl7ResultMessage != null)
{
    <h5>Inbound HL7 (Result Message)</h5>
    <pre class="bg-light p-3 border">@Model.Hl7ResultMessage</pre>
}

<a asp-action="Index" class="btn btn-secondary">Back</a>