<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedCore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="mc-sidebar p-3 d-flex flex-column">
            <div class="brand mb-4">MedCore</div>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <ul class="nav flex-column flex-grow-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Patients" asp-action="Index">Patients</a></li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Doctors" asp-action="Index">Doctors</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index">Appointments</a></li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Prescriptions" asp-action="Index">Prescriptions</a></li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Bills" asp-action="Index">Bills</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="LabOrders" asp-action="Index">Lab Orders</a></li>
                </ul>

                <div class="border-top border-light border-opacity-25 pt-3 mt-3">
                    <div class="mb-2">
                        <span class="mc-role-chip mc-role-@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Doctor") ? "Doctor" : "Receptionist")">
                            @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Doctor") ? "Doctor" : "Receptionist")
                        </span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-light btn-sm w-100">Logout</button>
                    </form>
                </div>
            }
            else
            {
                <ul class="nav flex-column">
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                </ul>
            }
        </nav>
        <!-- Main content -->
        <div class="flex-grow-1 p-4">
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>