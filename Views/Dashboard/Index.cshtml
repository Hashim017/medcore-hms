@model MedCore.ViewModels.DashboardViewModel

<h2>Welcome, @(User.IsInRole("Doctor") ? "Dr. " : "")@ViewBag.DisplayName</h2>
<p class="text-muted">Role: @ViewBag.UserRole</p>

<div class="row mb-4 g-3">
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-3">
            <div class="mc-card"><h6>Total Patients</h6><h3>@Model.TotalPatients</h3></div>
        </div>
        <div class="col-md-3">
            <div class="mc-card"><h6>Total Doctors</h6><h3>@Model.TotalDoctors</h3></div>
        </div>
        <div class="col-md-3">
            <div class="mc-card warn"><h6>Pending Appointments</h6><h3>@Model.PendingAppointments</h3></div>
        </div>
        <div class="col-md-3">
            <div class="mc-card danger"><h6>Unpaid Bills</h6><h3>@Model.UnpaidBillsTotal.ToString("C", new System.Globalization.CultureInfo("en-US"))</h3></div>
        </div>
    }

    @if (User.IsInRole("Doctor"))
    {
        <div class="col-md-3">
            <div class="mc-card"><h6>Pending Appointments</h6><h3>@Model.PendingAppointments</h3></div>
        </div>
        <div class="col-md-3">
            <div class="mc-card"><h6>My Patients</h6><h3>@Model.MyPatientsCount</h3></div>
        </div>
        <div class="col-md-3">
            <div class="mc-card"><h6>My Prescriptions</h6><h3>@Model.MyPendingPrescriptions</h3></div>
        </div>
        <div class="col-md-3">
            <div class="mc-card warn"><h6>My Unpaid Bills</h6><h3>@Model.UnpaidBillsTotal.ToString("C", new System.Globalization.CultureInfo("en-US")))</h3></div>
        </div>
    }

    @if (User.IsInRole("Receptionist"))
    {
        <div class="col-md-3">
            <div class="mc-card"><h6>Pending Appointments</h6><h3>@Model.PendingAppointments</h3></div>
        </div>
        <div class="col-md-3">
            <div class="mc-card"><h6>New Patients (7d)</h6><h3>@Model.NewPatientsThisWeek</h3></div>
        </div>
        <div class="col-md-3">
            <div class="mc-card warn"><h6>Pending Lab Orders</h6><h3>@Model.PendingLabOrders</h3></div>
        </div>
        <div class="col-md-3">
            <div class="mc-card danger"><h6>Unpaid Bills</h6><h3>@Model.UnpaidBillsCount</h3></div>
        </div>
    }
</div>

<h4>Recent Appointments</h4>
<table class="table table-striped">
    <thead><tr><th>Patient</th><th>Doctor</th><th>Date</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var a in Model.RecentAppointments)
        {
            <tr>
                <td>@a.Patient?.FullName</td>
                <td>@a.Doctor?.FullName</td>
                <td class="mono">@a.AppointmentDate.ToString("g")</td>
                <td>@a.Status</td>
            </tr>
        }
    </tbody>
</table>